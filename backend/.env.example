# ---------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------

# "local" or "openai"
EMBEDDING_PROVIDER=local

# Local embedding model
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI embedding configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Leave empty to use the model's default dimension.
# text-embedding-3-small default: 1536
# text-embedding-3-large default: 3072
OPENAI_EMBEDDING_DIMENSIONS=

# Number of documents embedded per request/batch.
EMBEDDING_BATCH_SIZE=64

# Each embedding model receives its own Chroma collection.
CHROMA_COLLECTION_PREFIX=movie-docs

# Optional explicit override. Usually leave empty.
CHROMA_COLLECTION_NAME=

# Explanations
EXPLANATION_PROVIDER=template
OPENAI_EXPLANATION_MODEL=gpt-5.4-mini

# Intent parsing
INTENT_PARSER_PROVIDER=template
OPENAI_INTENT_MODEL=gpt-5.4-mini

# TMDB API
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
TMDB_LANGUAGE=en-US
TMDB_MAX_MOVIES=12000
TMDB_MIN_VOTE_COUNT=20
TMDB_MIN_POPULARITY=1.0
TMDB_REQUEST_SLEEP_SECONDS=0.05