# Choose "local" or "openai"
EMBEDDING_PROVIDER=local

# Required only when EMBEDDING_PROVIDER=openai
# if later use OpenAI, make sure to create a new .env file
OPENAI_API_KEY=your_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Used when EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma
CHROMA_COLLECTION_NAME=movie_documents

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=32

# Explanations
EXPLANATION_PROVIDER=template
OPENAI_EXPLANATION_MODEL=gpt-5.4-mini

# Intent parsing
INTENT_PARSER_PROVIDER=template
OPENAI_INTENT_MODEL=gpt-5.4-mini

# TMDB API
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
TMDB_LANGUAGE=en-US
TMDB_MAX_MOVIES=12000
TMDB_MIN_VOTE_COUNT=20
TMDB_MIN_POPULARITY=1.0
TMDB_REQUEST_SLEEP_SECONDS=0.05